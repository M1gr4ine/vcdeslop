#!/bin/sh
set -eu

HARNESS="${1:-claude}"
INPUT="$(cat)"

if [ -z "$INPUT" ]; then
  printf '{}\n'
  exit 0
fi

# Parse only top-level JSON fields. If jq is unavailable or input is invalid, fail open.
if ! command -v jq >/dev/null 2>&1; then
  printf '{}\n'
  exit 0
fi

PROMPT="$(printf '%s\n' "$INPUT" | jq -er --arg harness "$HARNESS" '
  if type != "object" then empty
  elif $harness == "antigravity" and has("invocationNum") and .invocationNum != 0 then empty
  else [.lastUserInput, .prompt, .user_prompt] | map(select(type == "string" and length > 0)) | .[0] // ""
  end
' 2>/dev/null)" || PROMPT=""

if [ -z "$PROMPT" ]; then
  printf '{}\n'
  exit 0
fi

REVIEW_ERE='(^|[^0-9A-Za-z_])(code[[:space:]]+review|pr[[:space:]]+review|diff[[:space:]]+review|(vc)?deslop|(review|audit)([^0-9A-Za-z_].{0,36})?[^0-9A-Za-z_](this|my|the|current|branch|pr|diff|commit|changes?|code|maintainability|project|repo|repository))([^0-9A-Za-z_]|$)|代码审查|审查代码|审一下|(^|[^0-9A-Za-z_])review[[:space:]]*一下|(看看|检查|审视).{0,36}(改动|代码|diff|提交|质量|品位)|去[[:space:]]*AI[[:space:]]*味'

if ! printf '%s\n' "$PROMPT" | grep -Eiq "$REVIEW_ERE"; then
  printf '{}\n'
  exit 0
fi

REMINDER='[vcdeslop auto-trigger] Review/cleanup intent detected: activate the `vcdeslop` skill and follow its protocol (preflight scan if Python exists -> fresh same-model reviewer subagent -> verdict or surgical cleanup).'

if [ "$HARNESS" = "antigravity" ]; then
  printf '{"injectSteps":[{"systemMessage":{"systemMessage":"%s"}}]}\n' "$REMINDER"
else
  printf '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"%s"}}\n' "$REMINDER"
fi
